@model MiBotica.SolPedido.Entidades.Core.Usuario

@{
    ViewBag.Title = "Eliminar Usuario";
}

<div class="box box-danger">
    <div class="box-header with-border">
        <h3 class="box-title">
            <i class="fa fa-exclamation-triangle"></i> Confirmar Eliminación
        </h3>
    </div>
    <div class="box-body">
        <p class="text-muted">¿Estás seguro que deseas eliminar este usuario? Esta acción no se puede deshacer.</p>

        <div class="well" style="background-color:#f9f9f9;">
            <dl class="dl-horizontal" style="margin-bottom:0;">
                <dt>Id Usuario</dt>
                <dd>@Html.DisplayFor(model => model.IdUsuario)</dd>

                <dt>Código</dt>
                <dd>@Html.DisplayFor(model => model.CodUsuario)</dd>

                <dt>Nombres</dt>
                <dd>@Html.DisplayFor(model => model.Nombres)</dd>
            </dl>
        </div>
    </div>
    <div class="box-footer">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">
                <i class="fa fa-trash"></i> Eliminar
            </button>
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default" })
        }
    </div>
</div>

    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }